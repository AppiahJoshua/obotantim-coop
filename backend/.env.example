PORT=5000
NODE_ENV=development

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=obotantim_coop
MYSQL_CONNECTION_LIMIT=10

# SMTP email outbox worker (configure to enable email delivery)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Obotantim Cooperative <no-reply@example.com>
APP_BASE_URL=http://localhost:5173


# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Security hardening (generate random 32-byte keys; keep outside source control)
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters
BACKUP_ENCRYPTION_KEY=replace_with_another_64_hex_characters

# Optional daily local encrypted backups
BACKUP_SCHEDULER_ENABLED=false
BACKUP_CRON=0 2 * * *
BACKUP_DIRECTORY=./backups
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

# Optional Arkesel Ghana SMS delivery
ARKESEL_API_KEY=your_arkesel_api_key
ARKESEL_SENDER_ID=Obotantim
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
